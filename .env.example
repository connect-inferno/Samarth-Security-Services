# Copy to `.env.local` for local development, and set the same values in your
# host's environment settings for production (Vercel → Settings → Env Vars).
#
# `.env.local` is gitignored. NEVER commit real secrets.
#
# ⚠️  Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and is
#     therefore PUBLIC. Never use that prefix for API keys, tokens or passwords.

# Canonical origin, no trailing slash. Drives canonical URLs, Open Graph tags,
# sitemap.xml, robots.txt and JSON-LD. Falls back to the value in data/site.ts.
NEXT_PUBLIC_SITE_URL=https://samarthsecurityservices.gadadegroup.in

# ── If you later wire the contact form to a backend ──────────────────────
# Keep these server-side (no NEXT_PUBLIC_ prefix) so they stay out of the bundle.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
